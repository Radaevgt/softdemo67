# Скопируйте в .env и задайте значения перед первым запуском.

POSTGRES_USER=portal
POSTGRES_PASSWORD=смените-пароль-базы
POSTGRES_DB=portal

# Ключ подписи токенов. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Учётная запись оператора, создаётся при первом старте на пустой базе.
APP_BOOTSTRAP_OPERATOR_LOGIN=operator
APP_BOOTSTRAP_OPERATOR_PASSWORD=

APP_CORS_ORIGINS=http://localhost:8080
PORTAL_PORT=8080
